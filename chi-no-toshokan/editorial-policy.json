{
  "schemaVersion": 1,
  "rulebookVersion": "1.4",
  "lastUpdated": "2026-11-04",
  "authoritativeSource": "Google Docs",
  "rulebookUrl": "https://docs.google.com/document/d/103erzlFgvoIIsvBHxd0ZgdfHcnP7vf2utMxaVsrqtOA/edit",
  "mode": "private_drafts_only",
  "unattended_publication": false,
  "statement": "本人が気になりAIと調べた問いを、原資料の該当箇所に照らし、実名で誠実に共有する。主張が未照合なら公開しない。実装されていない自動検証を稼働中と扱わない。",
  "sourcePolicy": {
    "allowed": [
      "explicitly approved public-safe editorial records",
      "public research metadata as topic only",
      "verified original sources",
      "user-approved conversation extracts"
    ],
    "prohibitedWithoutApproval": [
      "entire ChatGPT conversation archive",
      "school-internal documents",
      "student or parent identifiers",
      "private Apple Music history",
      "unreleased composition",
      "anonymous rap persona linked to real name"
    ],
    "publicResearchDossierStatus": "unverified-metadata-not-publishable"
  },
  "magazines": [
    {
      "id": "ai-work",
      "goalPerWeek": 2,
      "readers": "AIで仕事を改善したい人"
    },
    {
      "id": "music-education",
      "goalPerWeek": 2,
      "readers": "音楽教育関係者"
    },
    {
      "id": "composing",
      "goalPerWeek": 1,
      "readers": "音楽制作に興味のある人"
    },
    {
      "id": "knowledge",
      "goalPerWeek": 1,
      "readers": "音楽理論・歴史・知識探究の読者"
    },
    {
      "id": "tools",
      "goalPerWeek": 1,
      "readers": "実用教材・ICTツールを必要とする人"
    }
  ],
  "articleFormats": {
    "short": {
      "targetMinChars": 800,
      "targetMaxChars": 1200,
      "bodyImages": "optional",
      "toc": "usually-unnecessary"
    },
    "standard": {
      "targetMinChars": 1500,
      "targetMaxChars": 2500,
      "bodyImages": "only-when-useful",
      "toc": "when-headings-are-useful"
    },
    "deep": {
      "targetMinChars": 3000,
      "targetMaxChars": 5000,
      "bodyImages": "only-when-verified",
      "toc": "when-headings-are-useful"
    }
  },
  "noteVisuals": {
    "headerWidth": 1280,
    "headerHeight": 670,
    "maxMB": 10,
    "imagesNeedSourceRights": true,
    "neverFabricateRealWorldPhotos": true,
    "style": "restrained; readable on mobile; no unrelated decoration"
  },
  "writing": {
    "keep": [
      "the user's actual questions",
      "thinking process",
      "uncertainty",
      "verified observations",
      "natural Japanese style",
      "readability",
      "the author’s evidenced curiosity and original questions",
      "plain, natural first-person tone only for actual author statements",
      "AI-assisted research with source-checked facts",
      "transparent correction record when factual errors are found"
    ],
    "avoid": [
      "fake successes",
      "fake emotions",
      "fabricated teacher or student reactions",
      "every-article same three points",
      "padding for character count",
      "misleading clickbait",
      "invented personal curiosity, personal reactions, or first-hand experiences",
      "predictable AI-style summaries and inflated headlines",
      "presenting source links as proof without checking supporting passages"
    ],
    "factCheck": "Every claim tied to credible source or tagged as unverified; research metadata alone does not prove claims."
  },
  "publication": {
    "default": "hold_for_verified_official_integration",
    "availableNow": "prepare private manuscript package; manually publish on note",
    "noteAPIRestriction": "Official publishing API is intended for note pro corporate customers through supported partners; do not use undocumented APIs.",
    "prohibitReadyIf": [
      "no explicit publication scope",
      "school/student/parent personal data",
      "unverified claims",
      "unknown image/audio/sheet music rights",
      "unapproved unpublished creative intent",
      "broken deployment",
      "no official publisher integration",
      "insufficiently evidenced author interest",
      "claim-by-claim citations incomplete",
      "source text inaccessible or abstract-only for claims beyond the abstract",
      "unavailable correction contact or inaccurate publication claims",
      "rulebook mismatch or verification engine untested"
    ],
    "publishedRequiresPublicUrl": true
  },
  "targetCadence": {
    "startPerWeek": 4,
    "steadyPerWeek": 7,
    "indicators": [
      "quality",
      "unverified-claims",
      "duplicate-rate",
      "human-input-minutes",
      "private-draft-inventory",
      "7-day-pageviews"
    ]
  },
  "featureStatus": {
    "currentlyImplemented": [
      "private records under RLS",
      "magazine routing",
      "research idea intake from public metadata",
      "copy editorial briefs",
      "write and store draft body",
      "canvas cover PNG export",
      "heading extraction and suggested note TOC",
      "suggested body visuals",
      "mobile readability preview",
      "manual 7-day metrics"
    ],
    "notImplemented": [
      "all-chat automatic extraction",
      "continuous AI draft generation",
      "automatic AI image generation",
      "autonomous validation of source text",
      "official personal note publishing",
      "note engagement auto-fetch",
      "verified auto-publishing gate based on external source passages",
      "reviewed and authorized correction-contact workflow"
    ]
  },
  "safeguards": {
    "stopOnError": true,
    "neverPubliclyStorePrivateDrafts": true,
    "noSecretsInRepository": true,
    "disableAutoPublicWhenRulebookMismatch": true,
    "authRequiredToReadPrivateDrafts": true
  },
  "evidenceGate": {
    "required": true,
    "status": "active_rules_draft_publication_blocked",
    "sourcePresenceIsNotFactVerification": true,
    "verifyEachFactualClaim": true,
    "requiredFields": [
      "claim",
      "documentTitle",
      "institutionOrAuthor",
      "sourceUrl",
      "pageOrSection",
      "sourceExcerptOrFaithfulParaphrase",
      "accessedAt",
      "verificationStatus",
      "sourceAccessLevel",
      "factualOrInterpretive",
      "claimLevelPassageLocation"
    ],
    "allowedValues": [
      "confirmed",
      "partial",
      "interpretation",
      "contradictory",
      "unverified"
    ],
    "blockIf": [
      "contradictory",
      "unverified"
    ],
    "researchMetadataNeverSufficient": true,
    "articleReadyOnlyAfterEveryClaimVerified": true,
    "visualsAlsoRequireRightsAndAccuracy": true,
    "pilotRun": "30 unpublished exploratory drafts; 5 source-mapped expanded drafts; publication remains blocked",
    "autonomousClaimVerificationOperational": false,
    "humanAndSourceReviewStillRequired": true
  },
  "editorialIdentity": {
    "publicByline": "the real-name author; never impersonate a researcher",
    "stance": "share questions the author actually pursued and things learned with AI after source-level verification",
    "correctionNotice": "Invite factual corrections with evidence; investigate, correct, and log changes",
    "correctionNoticeRequiresWorkingChannel": true,
    "noInventedFirstPersonExperiences": true,
    "noMandatoryAIDisclosureFormula": true
  },
  "topicSelection": {
    "priority": [
      "user-evidenced personal curiosity",
      "adjacent topics with separate relevance review",
      "AI suggestions requiring author interest confirmation"
    ],
    "authorInterestRequiredForPublication": true,
    "teachingTopicAloneIsNotInterestEvidence": true,
    "authorExcludedTopics": [
      "Beethoven Symphony No.5 lesson article",
      "Schubert Erlkönig lesson article"
    ],
    "archivedExcludedDraftsMustNotBePublished": true
  },
  "aiUseExperience": {
    "permittedSubjects": [
      "actual work-process experiments",
      "verified software or GAS trials",
      "AI-assisted research and learning when documented"
    ],
    "prohibitPublicAIImageGenerationShowcase": true,
    "useOnlyVerifiedActualAchievements": true
  }
}
